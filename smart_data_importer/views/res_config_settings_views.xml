<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.smart.importer</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Smart Importer" string="Smart Importer" name="smart_data_importer" groups="smart_data_importer.group_smart_importer_admin">
                    <block title="General Settings" name="smart_importer_general">
                        <setting string="Max File Size (MB)" help="Maximum allowed size for uploaded files.">
                            <field name="smart_data_importer_max_file_size_mb"/>
                        </setting>
                        <setting string="Fuzzy Threshold" help="Threshold for Levenshtein matching (0-100).">
                            <field name="smart_data_importer_fuzzy_threshold"/>
                        </setting>
                        <setting string="Chunk Size" help="Number of records to process per job. Default is 500 to avoid worker timeout.">
                            <field name="smart_data_importer_chunk_size"/>
                        </setting>
                    </block>
                    <block title="AI Universal Assistant (DeepSeek, Claude, Gemini, GPT)" name="smart_importer_llm">
                        <setting string="Enable AI Engine" help="Enables AI to analyze spreadsheets, auto-generate templates, suggest mappings and normalization rules.">
                            <field name="smart_data_importer_llm_enabled"/>
                        </setting>
                        <setting string="Provider" invisible="not smart_data_importer_llm_enabled">
                            <field name="smart_data_importer_llm_provider"/>
                        </setting>
                        <setting string="Model Name" invisible="not smart_data_importer_llm_enabled" help="Leave blank to use the provider default (deepseek-chat, claude-haiku-5-5, gemini-3.5-flash-lite, gpt-4o-mini).">
                            <field name="smart_data_importer_llm_model" placeholder="e.g. deepseek-chat, claude-haiku-5-5, gemini-3.5-flash-lite"/>
                        </setting>
                        <setting string="API Key" invisible="not smart_data_importer_llm_enabled">
                            <field name="smart_data_importer_llm_api_key" password="True" placeholder="API key or token..."/>
                        </setting>
                        <setting string="Custom Base URL" invisible="not smart_data_importer_llm_enabled" help="Required for Custom/Local LLMs (Ollama http://localhost:11434/v1, Groq, OpenRouter). Optional proxy for others.">
                            <field name="smart_data_importer_llm_base_url" placeholder="https://api.groq.com/openai/v1"/>
                        </setting>
                        <setting string="Send sample values" invisible="not smart_data_importer_llm_enabled" help="If disabled, only the column headers are sent to the AI provider, never the cell contents.">
                            <field name="smart_data_importer_llm_send_samples"/>
                        </setting>
                        <setting string="Test Connection" invisible="not smart_data_importer_llm_enabled" help="Verify your AI credentials and model availability.">
                            <button name="action_test_llm_connection" type="object" string="⚡ Probar Conexión IA" class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_smart_importer_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'smart_data_importer'}</field>
    </record>
</odoo>